theorem exponents {n a b c : ℕ} (hn : 2000<n) (div : 9699690∣n) (pp : (n+1).Prime) (sol : Erdos889.v_l 1 n=1) (shape : n+10=2^a*5^b*23^c) (ha : 0<a) (hb : 0<b) (hc : 0<c) : a%12=1 ∧ b%12=1 ∧ c%12=0 := by
