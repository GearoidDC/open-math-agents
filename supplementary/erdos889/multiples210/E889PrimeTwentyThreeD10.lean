  have bad : ¬Target cfg a b c := by
    rintro ⟨a1,b1,c1⟩
    exact neg ⟨a1,b1,c1⟩
  have h : H cfg n a b c := ⟨shape,ha,hb,Or.inl hc,by simp [cfg],hn,div,pp,sol⟩
  have h1 : Match 1 a b c keys1 := ⟨0,by decide,Nat.mod_one _,Nat.mod_one _,Nat.mod_one _⟩
