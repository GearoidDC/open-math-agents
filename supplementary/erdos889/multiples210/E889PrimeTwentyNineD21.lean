theorem exponents {n a b c : ℕ} (hn : 2000<n) (div : 223092870∣n) (pp : (n+1).Prime) (sol : Erdos889.v_l 1 n=1) (shape : n+21=3^a*7^b*29^c) (ha : 0<a) (hb : 0<b) (hc : 0<c) : a%12=1 ∧ b%12=1 ∧ c%12=0 := by
