theorem exponents {n a b c : ℕ} (hn : 2000<n) (div : 210∣n) (pp : (n+1).Prime) (sol : Erdos889.v_l 1 n=1) (shape : n+10=2^a*5^b*11^c) (ha : 0<a) (hb : 0<b) (hc : 0<c) : a%12=1 ∧ b%12=1 ∧ c%12=0 := by
  by_contra neg
  have bad : ¬Target cfg a b c := by
    rintro ⟨a1,b1,c1⟩
    exact neg ⟨a1,b1,c1⟩
  have h : H cfg n a b c := ⟨shape,ha,hb,Or.inl hc,by simp [cfg],hn,div,pp,sol⟩
  have h1 : Match 1 a b c keys1 := ⟨0,by decide,Nat.mod_one _,Nat.mod_one _,Nat.mod_one _⟩
  have h12 := run12 h bad h1
  have h36 := run36 h bad h12
  have h180 := run180 h bad h36
  have h360 := run360 h bad h180
  have h720 := run720 h bad h360
  obtain ⟨i,hi,_⟩ := h720
  exact Nat.not_lt_zero i hi
