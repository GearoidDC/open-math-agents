private def witness (n code : ℕ) : Bool :=
  if code=0 then decide (541∣n+207 ∧ 577∣n+207) else FiniteThirty.test n code

private theorem witness_sound {n code : ℕ} (h : witness n code=true) : v_l 1 n≠1 := by
  unfold witness at h
  split at h
  · obtain ⟨a,b⟩ := of_decide_eq_true h
    exact OMA.R_Erdos889_erdos_889_variants_v1_eq_1_finite_R2.two_primes
      (by decide : 0 < 207) (by norm_num : Nat.Prime 541) (by norm_num : Nat.Prime 577)
      (by decide) (by decide) (by decide) a b
  · exact FiniteThirty.test_sound h

private def block (start : ℕ) : ℕ → ℕ → Bool
  | 0, _ => true
  | j+1, data => witness (2305567963945518424753102147331756070*(start+j+1)) (data%262144) && block start j (data/262144)

private theorem block_sound {s count data i : ℕ} (ok : block s count data=true)
    (lo : s ≤ i) (hi : i < s + count) : v_l 1 (2305567963945518424753102147331756070*(i+1))≠1 := by
  induction count generalizing data with
  | zero => omega
  | succ j ih =>
    simp only [block,Bool.and_eq_true] at ok
    by_cases last : i=s+j
    · subst i; exact witness_sound ok.1
    · exact ih ok.2 (by omega)

