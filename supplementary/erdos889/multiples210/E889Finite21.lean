private def scan (B r : ℕ) (f : ℕ → Bool) : ℕ → ℕ → Bool
  | 0, _ => true
  | j+1, x => if B<x then true else f x && scan B r f j (x*r)

private def walk (B : ℕ) (f : ℕ → Bool) : List ℕ → ℕ → Bool
  | [], x => f x
  | r::rs, x => scan B r (walk B f rs) 71 x

private theorem scan_sound {B r x fuel e : ℕ} (f : ℕ → Bool) (rp : 0<r)
    (all : scan B r f fuel x=true) (inside : e<fuel) (cap : x*r^e≤B) :
    f (x*r^e)=true := by
  induction fuel generalizing x e with
  | zero => omega
  | succ fuel ih =>
    have low : x≤B := (Nat.le_mul_of_pos_right x (pow_pos rp _)).trans cap
    simp only [scan,if_neg (Nat.not_lt.mpr low),Bool.and_eq_true] at all
    cases e with
    | zero => simpa only [pow_zero,mul_one] using all.1
    | succ e =>
      rw [pow_succ',←Nat.mul_assoc] at cap ⊢
      exact ih all.2 (by omega) cap

private theorem walk_sound {B x z : ℕ} (f : ℕ → Bool) (rs : List ℕ)
    (hi : B<2^71) (xp : 0<x) (zp : 0<z) (cap : x*z≤B)
    (prime : ∀ q∈rs, q.Prime) (support : ∀ q : ℕ, q.Prime → q∣z → q∈rs)
    (all : walk B f rs x=true) : f (x*z)=true := by
  induction rs generalizing x z with
  | nil =>
    have one : z=1 := by
      by_contra ne
      obtain ⟨q,pq,dq⟩ := Nat.exists_prime_and_dvd ne
      simpa using support q pq dq
    simpa only [walk,one,mul_one] using all
  | cons r rs ih =>
    have pr := prime r (by simp)
    let e := z.factorization r
    let w := z/r^e
    have wp : 0<w := Nat.ordCompl_pos r zp.ne'
    have eq : r^e*w=z := Nat.ordProj_mul_ordCompl_eq_self _ _
    have nz : ¬r∣w := Nat.not_dvd_ordCompl pr zp.ne'
    have re : 0<r^e := pow_pos pr.pos _
    have cap' : x*r^e*w≤B := by simpa only [Nat.mul_assoc,eq] using cap
    have capR := (Nat.le_mul_of_pos_right (x*r^e) wp).trans cap'
    have exp : e<71 := by
      by_contra! low
      have := calc
        2^71 ≤ 2^e := Nat.pow_le_pow_right (by decide) low
        _ ≤ r^e := Nat.pow_le_pow_left pr.two_le e
        _ ≤ x*r^e := Nat.le_mul_of_pos_left _ xp
        _ ≤ B := capR
      omega
    have after := scan_sound (walk B f rs) pr.pos all exp capR
    have res := ih (Nat.mul_pos xp re) wp cap'
      (fun q mq => prime q (List.mem_cons_of_mem r mq)) (fun q pq dq =>
        (List.mem_cons.mp (support q pq (dq.trans (Nat.ordCompl_dvd z r)))).resolve_left
          (by rintro rfl; exact nz dq)) after
    simpa only [Nat.mul_assoc,eq] using res

