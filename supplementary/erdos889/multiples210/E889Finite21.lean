private def test (n code : ℕ) : Bool :=
  let u := code%512
  let v := code/512
  let k := u-n%u
  catalog u && catalog v && decide (u<v ∧ 0<k ∧ k<u ∧ u∣n+k ∧ v∣n+k)

private theorem test_sound {n code : ℕ} (ok : test n code=true) : v_l 1 n≠1 := by
  unfold test at ok
  simp only [Bool.and_eq_true, decide_eq_true_eq] at ok
  obtain ⟨⟨pu,pv⟩,uv,kp,ku,du,dv⟩ := ok
  exact two_primes kp (catalog_sound pu) (catalog_sound pv) uv.ne ku (ku.trans uv) du dv


private def witness (n : ℕ) : Bool :=
  let bucket := witnessBucket (n%127)
  test n ((bucket.2 >>> (18*(n%bucket.1)))%262144)

private def accepts (M : ℕ) (ks : List ℕ) (x : ℕ) : Bool :=
  let k := x%M
  let n := x-k
  if lowBound<n ∧ n≤highBound ∧ k∈ks then witness n else true

private def groupOK (M p : ℕ) (bs ks : List ℕ) :=
  walk (highBound+p) (accepts M ks) bs p

private theorem group_sound {n M p k : ℕ} (bs ks : List ℕ)
    (lp : p≤53) (pp : p.Prime) (lt : k<M) (kp : k<p) (mem : k∈ks)
    (div : M∣n) (pd : p∣n+k) (lo : lowBound<n) (hi : n≤highBound)
    (prime : ∀ q∈bs, q.Prime)
    (sup : ∀ q : ℕ, q.Prime → q∣n+k → q∈bs)
    (ok : groupOK M p bs ks=true) : v_l 1 n≠1 := by
  obtain ⟨w,eq⟩ := pd
  have wp : 0<w := by
    by_contra! h
    rw [show w=0 by omega,mul_zero] at eq
    have := lo; unfold lowBound at this; omega
  have val := walk_sound (accepts M ks) bs (by unfold highBound; omega) pp.pos wp
    (show p*w≤highBound+p by omega) prime
    (fun q pq dq => sup q pq (eq ▸ dvd_mul_of_dvd_right dq p)) ok
  rw [←eq] at val
  have md : (n+k)%M=k := by rw [Nat.add_mod,Nat.mod_eq_zero_of_dvd div,zero_add,Nat.mod_mod,Nat.mod_eq_of_lt lt]
  simp only [accepts,md,Nat.add_sub_cancel,if_pos (show lowBound<n ∧ n≤highBound ∧ k∈ks from ⟨lo,hi,mem⟩)] at val
  unfold witness at val
  exact test_sound val

private theorem force_step {n M p : ℕ} (pp : p.Prime) (cop : M.Coprime p)
    (small : ∀ q∈List.range p, q.Prime → q∣M) (div : M∣n) (sol : v_l 1 n=1)
    (excl : ∀ k : ℕ, 0<k → k<p → p∣n+k →
      (∀ q : ℕ, q.Prime → q∣n+k → q=p ∨ q∣k) → False) : M*p∣n := by
  apply cop.mul_dvd_of_dvd_of_dvd div
  by_contra miss
  let k := p-n%p
  have rem := Nat.mod_lt n pp.pos
  have nz : n%p≠0 := fun h => miss (Nat.dvd_of_mod_eq_zero h)
  have pos : 0<k := by dsimp only [k]; omega
  have lt : k<p := by dsimp only [k]; omega
  have dk : p∣n+k := by
    apply Nat.dvd_of_mod_eq_zero
    rw [Nat.add_mod,Nat.mod_eq_of_lt lt,show n%p+k=p by dsimp only [k]; omega,Nat.mod_self]
  apply excl k pos lt dk
  intro q pq dq
  by_cases qk : q≤k
  · exact Or.inr ((Nat.dvd_add_iff_right ((small q (List.mem_range.mpr (by omega)) pq).trans div)).mpr dq)
  · by_contra! ne
    exact two_primes pos pp pq (Ne.symm ne.1) lt (by omega) dk dq sol

