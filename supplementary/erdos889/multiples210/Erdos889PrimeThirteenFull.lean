/-- Every sufficiently large prime-successor solution divisible by the primes through
eleven is also divisible by their product with thirteen. -/
theorem primorial_thirteen {n : ℕ} (big : 1000000000000000000<n) (div : 2310∣n)
    (pp : (n+1).Prime) (sol : v_l 1 n=1) : 30030∣n := by
  have d : 13∣n := by
    by_contra missing
    let j := 13-n%13
    have nz : n%13≠0 := fun h => missing (Nat.dvd_of_mod_eq_zero h)
    have hj : 0<j := by dsimp only [j]; omega
    have lo : j<13 := by dsimp only [j]; omega
    have sum : n%13+j=13 := by dsimp only [j]; omega
    have hit : 13∣n+j := by
      apply Nat.dvd_of_mod_eq_zero
      rw [Nat.add_mod,Nat.mod_eq_of_lt lo,sum,Nat.mod_self]
    exact exclude_offset big div pp sol hj lo hit
  exact (by decide : Nat.Coprime 2310 13).mul_dvd_of_dvd_of_dvd div d

end Erdos889.PrimeThirteen
