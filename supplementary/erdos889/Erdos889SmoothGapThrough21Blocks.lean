private def test (n code : ℕ) : Bool :=
  let u := code%512
  let v := code/512
  let k := u-n%u
  decide (u.Prime ∧ v.Prime ∧ u<v ∧ 0<k ∧ k<u ∧ u∣n+k ∧ v∣n+k)

private theorem test_sound {n code : ℕ} (ok : test n code=true) : v_l 1 n≠1 := by
  unfold test at ok
  obtain ⟨pu,pv,uv,kp,ku,du,dv⟩ := of_decide_eq_true ok
  exact two_primes kp pu pv uv.ne ku (ku.trans uv) du dv

private def testBlock : ℕ → ℕ → ℕ → ℕ → Bool
  | 0, _, _, _ => true
  | k+1, m, i, blob => test ((i+1)*m) (blob%262144) && testBlock k m (i+1) (blob/262144)

private theorem block_sound {len m start i blob : ℕ}
    (hg : testBlock len m start blob=true) (lo : start ≤ i) (hi : i < start + len) :
    v_l 1 ((i+1)*m)≠1 := by
  induction len generalizing start blob with
  | zero => omega
  | succ len ih =>
    simp only [testBlock,Bool.and_eq_true] at hg
    by_cases first : i=start
    · subst i; exact test_sound hg.1
    · exact ih hg.2 (by omega) (by omega)

private def nEntries (q : ℕ) := 1000000000000000000000/(bases q).prod
private def blockLen (q b : ℕ) := min 64 (nEntries q-64*b)
private def blocksOK (q : ℕ) : Bool :=
  ((List.range (nEntries q/64+1)).all (fun b =>
    testBlock (blockLen q b) (bases q).prod (64*b) (packed q b)))

