private theorem all_good : ∀ q∈primes, blocksOK q=true := by
  intro q mem
  simp only [primes,List.mem_cons,List.not_mem_nil,or_false] at mem
  rcases mem with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
  · exact block2
  · exact block3
