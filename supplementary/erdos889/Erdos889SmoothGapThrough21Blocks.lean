  · exact block19
  · exact block23
  · exact block29
  · exact block31
  · exact block37
  · exact block41
  · exact block43
  · exact block47
  · exact block53

private theorem check {q i : ℕ} (mem : q∈primes) (lim : i<nEntries q) :
    v_l 1 ((i+1)*(bases q).prod)≠1 := by
  let b := i/64
  have memB : b∈List.range (nEntries q/64+1) := List.mem_range.mpr (by dsimp only [b]; omega)
  have tab := List.all_eq_true.mp (all_good q mem) b memB
  apply block_sound tab
  · dsimp only [b]; omega
  · dsimp only [blockLen,b]; omega

/-- Conditional on the 53-smooth pair bound, the sparse progression check
excludes all candidate starting points between 10^18 and 10^21. -/
theorem no_solution_through_10_pow_21
    (smooth_pair : ∀ x y : ℕ, 0<x → x<y → y≤x+51 →
      (∀ r : ℕ, r.Prime → r∣x → r≤53) →
      (∀ r : ℕ, r.Prime → r∣y → r≤53) → x≤87697857812500)
    {n : ℕ} (big : 1000000000000000000<n) (lim : n≤1000000000000000000000) :
    v_l 1 n≠1 := by
  intro sol
  have unique (p : ℕ) (mp : p∈primes) (q : ℕ) (mq : q∈primes)
      (dp : ¬p∣n) (dq : ¬q∣n) : p=q :=
    missing_prime_unique smooth_pair big sol (qdata p mp).1 (qdata q mq).1
      (qdata p mp).2 (qdata q mq).2 dp dq
  obtain ⟨q,mq,w,eq⟩ := progression unique
  have wp : 0<w := by by_contra! h; simp [show w=0 by omega] at eq; omega
  have mpos : 0<(bases q).prod := by
    have tab : ∀ r∈primes, 0<(bases r).prod := by decide +kernel
    exact tab q mq
  have bound : w≤1000000000000000000000/(bases q).prod :=
    (Nat.le_div_iff_mul_le mpos).mpr (by simpa only [Nat.mul_comm w,←eq] using lim)
  have bad := check mq (i:=w-1) (by unfold nEntries; omega)
  rw [Nat.sub_add_cancel wp,Nat.mul_comm w,←eq] at bad
  exact bad sol

end Erdos889.SmoothGap
